{
  "name": "freikontor-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Shop mit automatisierter Auslieferung für das Freikontor Finanzcockpit",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "sync-products": "node scripts/sync-products.js",
    "check-config": "node --disable-warning=ExperimentalWarning scripts/check-config.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.3.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@fontsource/inter": "5.2.8"
  }
}
