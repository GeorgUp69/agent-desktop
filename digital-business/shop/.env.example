# Kopieren nach .env und ausfüllen. .env niemals committen.
NODE_ENV=production
PORT=3000
BASE_URL=https://www.deine-domain.de

# Stripe: Dashboard -> Entwickler -> API-Schlüssel (zuerst Testmodus sk_test_..., für den Start sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe: Dashboard -> Entwickler -> Webhooks -> Endpunkt https://www.deine-domain.de/stripe/webhook -> Signaturgeheimnis
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 1 = nur Live-Zahlungen ausliefern (für den Produktivbetrieb mit sk_live empfohlen)
STRIPE_REQUIRE_LIVEMODE=0

# SMTP eines E-Mail-Anbieters mit Auftragsverarbeitungsvertrag (AVV)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=noreply@deine-domain.de
SMTP_PASS=xxx
MAIL_FROM="Freikontor <noreply@deine-domain.de>"
OWNER_NOTIFY_EMAIL=du@deine-domain.de

# Mindestens 32 zufällige Zeichen, z. B.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Benutzer "admin", Passwort mindestens 12 Zeichen
ADMIN_PASSWORD=

# Optional: TikTok Pixel-ID (lädt erst nach Einwilligung)
TIKTOK_PIXEL_ID=

DOWNLOAD_LINK_DAYS=30
MAX_DOWNLOADS_PER_FILE=20
