# Domain anpassen. Caddy holt das TLS-Zertifikat automatisch (Let's Encrypt).
www.deine-domain.de {
	encode zstd gzip
	reverse_proxy shop:3000
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep_for 168h
		}
		format filter {
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}
}
deine-domain.de {
	redir https://www.deine-domain.de{uri} permanent
}
